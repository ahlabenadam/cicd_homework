# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# APP_SECRET signs Flask session cookies. Use any long random string.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=change-me-to-a-long-random-string

# PORT sets the local port the app listens on (default: 5000).
# PORT=5000

# DEBUG enables the Flask/Werkzeug debugger (default: off — never enable in production).
# DEBUG=true

# ── Optional: customize the mock identity shown on the profile page ───────────
# MOCK_NAME=Local User
# MOCK_EMAIL=local@localhost
# MOCK_PICTURE=
