# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.
#
# GOOGLE_CLIENT_ID is already set in app/main.py — you do NOT need to add it here.
# You DO need to create a Google OAuth client to get GOOGLE_CLIENT_SECRET:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create Credentials → OAuth Client ID
#   3. Application type: "Web application"
#   4. Add http://localhost:5000/callback to "Authorized redirect URIs"
#   5. Copy the Client Secret below

GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret-here

# APP_SECRET signs Flask session cookies. Use any long random string.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=change-me-to-a-long-random-string

# ── Advanced: Skip OAuth (local dev / CI without Google credentials) ──────────
#
# Set SKIP_OAUTH=true to bypass Google sign-in entirely.
# When enabled, GOOGLE_CLIENT_SECRET is NOT required.
#
# ⚠ WARNING: This disables ALL authentication.
#            Never use SKIP_OAUTH=true on a public or production server.
#
# Accepted values: true, 1, yes (case-insensitive). Default: (unset = OAuth enabled)
#
# SKIP_OAUTH=true
#
# Optional: customize the mock identity shown when SKIP_OAUTH=true
# MOCK_NAME=Local User
# MOCK_EMAIL=local@localhost
# MOCK_PICTURE=
